{
	"compilerOptions": {
		"target": "ES2024",
		"lib": [
			"ES2024"
		],
		"module": "preserve",
		// bundler resolution because esbuild is what actually builds this; tsc only checks.
		// node10 was removed in TypeScript 7 and this is its correct successor for a bundled
		// extension - extensionless imports keep working, which node16 would have broken.
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"strict": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedIndexedAccess": true,
		"forceConsistentCasingInFileNames": true,
		"exactOptionalPropertyTypes": false,
		"useUnknownInCatchVariables": false,
		"rootDir": "./src",
		"outDir": "./out",
		"types": [
			"node",
			"vscode"
		]
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"src/test"
	]
}
