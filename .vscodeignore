# Sources are bundled into out/extension.js and media/*/*.js, so shipping them would double the
# package for no benefit.
src/**
preview-src/**
scripts/**

# icon.png at the root is what ships; this is the vector it was rasterised from.
resources/**
build.mjs
eslint.config.mjs
.vscode-test.mjs
**/tsconfig*.json
.gitignore
.vscode/**
.vscode-test/**
node_modules/**

# Charts and strategies are documents the extension opens, never part of the extension. Saving
# one while a checkout is the open folder leaves it in the repository root, from where it would
# otherwise be packaged and installed onto every user as though it were program material.
*.chart
*.strategy

# Agent configuration, holding whatever the machine it was written on had been permitted to do.
# Listed here as well as in .gitignore because vsce reads this file instead of that one, so an
# ignored file is still a shipped file without this line.
.claude/**

# The test build emits loose modules beside the bundle, and every one of them would otherwise
# ship: compiling tests once took the package from 11 files to 53.
out/**
!out/extension.js
