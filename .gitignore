node_modules/
out/
*.vsix

# Webview bundles, built from preview-src by esbuild. Matched by shape rather than named one
# by one, so adding a webview does not also require remembering to ignore its output too.
media/*/*.js
media/*/*.js.map
.vscode-test/

# Local agent settings. Machine specific, so it stays out of the shared history.
.claude/settings.json
