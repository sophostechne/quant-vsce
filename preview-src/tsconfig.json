{
	"compilerOptions": {
		"target": "ES2024",
		"lib": [
			"ES2024",
			"DOM",
			"DOM.Iterable"
		],
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"forceConsistentCasingInFileNames": true,
		"rootDir": ".",
		"noEmit": true,
		"types": []
	},
	"include": [
		"./**/*.ts"
	]
}
