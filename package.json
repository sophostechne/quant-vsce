{
	"name": "quant-workbench",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "1.10.2",
	"publisher": "sophostechne",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/sophostechne/quant-vsce.git"
	},
	"homepage": "https://github.com/sophostechne/quant-vsce#readme",
	"bugs": {
		"url": "https://github.com/sophostechne/quant-vsce/issues"
	},
	"engines": {
		"vscode": "^1.133.0"
	},
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": false,
			"description": "%capabilities.untrustedWorkspaces.description%"
		}
	},
	"categories": [
		"Data Science",
		"Visualization",
		"Other"
	],
	"keywords": [
		"trading",
		"backtesting",
		"charts",
		"market data",
		"strategy"
	],
	"icon": "icon.png",
	"main": "./out/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "quant",
					"icon": "$(graph)",
					"title": "%container.title%"
				}
			]
		},
		"views": {
			"quant": [
				{
					"id": "quant.watchlist",
					"name": "%view.watchlist.title%"
				},
				{
					"id": "quant.strategies",
					"name": "%view.strategies.title%"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "quant.watchlist",
				"contents": "%viewsWelcome.watchlist%"
			}
		],
		"customEditors": [
			{
				"viewType": "quant.chart",
				"displayName": "%customEditor.chart.displayName%",
				"selector": [
					{
						"filenamePattern": "*.chart"
					}
				],
				"priority": "default"
			},
			{
				"viewType": "quant.strategy",
				"displayName": "%customEditor.strategy.displayName%",
				"selector": [
					{
						"filenamePattern": "*.strategy"
					}
				],
				"priority": "default"
			}
		],
		"languages": [
			{
				"id": "json",
				"extensions": [
					".chart",
					".strategy"
				]
			}
		],
		"commands": [
			{
				"command": "quant.connect",
				"title": "%cmd.connect%",
				"category": "%cmd.category%"
			},
			{
				"command": "quant.disconnect",
				"title": "%cmd.disconnect%",
				"category": "%cmd.category%"
			},
			{
				"command": "quant.addSymbol",
				"title": "%cmd.addSymbol%",
				"category": "%cmd.category%",
				"icon": "$(add)"
			},
			{
				"command": "quant.removeSymbol",
				"title": "%cmd.removeSymbol%",
				"category": "%cmd.category%",
				"icon": "$(close)"
			},
			{
				"command": "quant.openChart",
				"title": "%cmd.openChart%",
				"category": "%cmd.category%",
				"icon": "$(graph-line)"
			},
			{
				"command": "quant.showLog",
				"title": "%cmd.showLog%",
				"category": "%cmd.category%"
			},
			{
				"command": "quant.runBacktest",
				"title": "%cmd.runBacktest%",
				"category": "%cmd.category%",
				"icon": "$(play)"
			},
			{
				"command": "quant.addIndicator",
				"title": "%cmd.addIndicator%",
				"category": "%cmd.category%",
				"icon": "$(add)"
			},
			{
				"command": "quant.removeIndicator",
				"title": "%cmd.removeIndicator%",
				"category": "%cmd.category%",
				"icon": "$(close)"
			},
			{
				"command": "quant.setChartStyle",
				"title": "%cmd.setChartStyle%",
				"category": "%cmd.category%",
				"icon": "$(symbol-color)"
			},
			{
				"command": "quant.setChartScale",
				"title": "%cmd.setChartScale%",
				"category": "%cmd.category%",
				"icon": "$(graph-scatter)"
			},
			{
				"command": "quant.draw",
				"title": "%cmd.draw%",
				"category": "%cmd.category%",
				"icon": "$(edit)"
			},
			{
				"command": "quant.clearDrawings",
				"title": "%cmd.clearDrawings%",
				"category": "%cmd.category%",
				"icon": "$(clear-all)"
			},
			{
				"command": "quant.editDrawing",
				"title": "%cmd.editDrawing%",
				"category": "%cmd.category%",
				"icon": "$(settings-gear)"
			},
			{
				"command": "quant.newStrategy",
				"title": "%cmd.newStrategy%",
				"category": "%cmd.category%",
				"icon": "$(new-file)"
			},
			{
				"command": "quant.newVisualizer",
				"title": "%cmd.newVisualizer%",
				"category": "%cmd.category%",
				"icon": "$(symbol-method)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "quant.addSymbol",
					"when": "view == quant.watchlist",
					"group": "navigation@1"
				},
				{
					"command": "quant.newStrategy",
					"when": "view == quant.strategies",
					"group": "navigation@1"
				}
			],
			"view/item/context": [
				{
					"command": "quant.openChart",
					"when": "view == quant.watchlist && viewItem == quant.symbol",
					"group": "inline@1"
				},
				{
					"command": "quant.removeSymbol",
					"when": "view == quant.watchlist && viewItem == quant.symbol",
					"group": "inline@2"
				},
				{
					"command": "quant.runBacktest",
					"when": "view == quant.strategies && viewItem == quant.strategy",
					"group": "inline@1"
				}
			],
			"commandPalette": [
				{
					"command": "quant.removeSymbol",
					"when": "never"
				},
				{
					"command": "quant.openChart",
					"when": "never"
				}
			],
			"editor/title/run": [
				{
					"command": "quant.runBacktest",
					"when": "resourceExtname == .py && resourceDirname =~ /strategies/",
					"group": "navigation@1"
				}
			],
			"editor/title": [
				{
					"command": "quant.setChartStyle",
					"when": "activeCustomEditorId == quant.chart",
					"group": "navigation@1"
				},
				{
					"command": "quant.setChartScale",
					"when": "activeCustomEditorId == quant.chart",
					"group": "navigation@2"
				},
				{
					"command": "quant.addIndicator",
					"when": "activeCustomEditorId == quant.chart",
					"group": "navigation@3"
				},
				{
					"command": "quant.removeIndicator",
					"when": "activeCustomEditorId == quant.chart",
					"group": "navigation@4"
				},
				{
					"command": "quant.draw",
					"when": "activeCustomEditorId == quant.chart",
					"group": "navigation@5"
				},
				{
					"command": "quant.clearDrawings",
					"when": "activeCustomEditorId == quant.chart",
					"group": "1_quant@1"
				},
				{
					"command": "quant.editDrawing",
					"when": "activeCustomEditorId == quant.chart",
					"group": "1_quant@0"
				}
			]
		},
		"configuration": {
			"title": "%config.title%",
			"properties": {
				"quant.chart.customIntervals": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^\\d+[smhDWM]?$"
					},
					"default": [],
					"markdownDescription": "%config.chart.customIntervals%"
				},
				"quant.daemon.host": {
					"type": "string",
					"default": "127.0.0.1",
					"description": "%config.daemon.host%"
				},
				"quant.daemon.port": {
					"type": "number",
					"default": 8787,
					"description": "%config.daemon.port%"
				},
				"quant.daemon.autoConnect": {
					"type": "boolean",
					"default": true,
					"description": "%config.daemon.autoConnect%"
				},
				"quant.daemon.allowSimulatedFeed": {
					"type": "boolean",
					"default": false,
					"description": "%config.daemon.allowSimulatedFeed%"
				},
				"quant.bars.url": {
					"type": "string",
					"default": "https://bars.sophostechne.com",
					"description": "%config.bars.url%"
				},
				"quant.watchlist.refreshIntervalMs": {
					"type": "number",
					"default": 250,
					"minimum": 50,
					"maximum": 5000,
					"description": "%config.watchlist.refreshIntervalMs%"
				},
				"quant.nautilus.projectPath": {
					"type": "string",
					"default": "",
					"description": "%config.nautilus.projectPath%"
				},
				"quant.nautilus.pythonPath": {
					"type": "string",
					"default": "",
					"description": "%config.nautilus.pythonPath%"
				},
				"quant.backtest.product": {
					"type": "string",
					"default": "BTC-USD",
					"description": "%config.backtest.product%"
				},
				"quant.backtest.timeframe": {
					"type": "string",
					"default": "5m",
					"enum": [
						"1m",
						"5m",
						"15m",
						"1h",
						"6h",
						"1d"
					],
					"description": "%config.backtest.timeframe%"
				},
				"quant.backtest.bars": {
					"type": "number",
					"default": 1200,
					"minimum": 50,
					"maximum": 10000,
					"description": "%config.backtest.bars%"
				},
				"quant.backtest.params": {
					"type": "object",
					"default": {},
					"description": "%config.backtest.params%"
				},
				"quant.engine.projectPath": {
					"type": "string",
					"default": "",
					"description": "%config.engine.projectPath%"
				},
				"quant.engine.pythonPath": {
					"type": "string",
					"default": "",
					"description": "%config.engine.pythonPath%"
				}
			}
		}
	},
	"scripts": {
		"compile": "node build.mjs",
		"watch": "node build.mjs --watch",
		"package": "node build.mjs --production && vsce package --no-dependencies",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p preview-src/tsconfig.json --noEmit && npm run check:vocabulary",
		"vscode:prepublish": "node build.mjs --production",
		"check:vocabulary": "node scripts/check-vocabulary.mjs",
		"watch:esbuild": "node build.mjs --watch",
		"watch:tsc": "tsc -p tsconfig.json --noEmit --watch",
		"compile-tests": "tsc -p tsconfig.test.json",
		"watch-tests": "tsc -p tsconfig.test.json --watch",
		"lint": "eslint src preview-src",
		"test": "npm run compile-tests && npm run compile && vscode-test"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/vscode": "^1.90.0",
		"@vscode/test-cli": "^0.0.10",
		"@vscode/test-electron": "^2.4.1",
		"@vscode/vsce": "^3.2.0",
		"esbuild": "^0.24.0",
		"eslint": "^9.17.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.19.0"
	}
}
